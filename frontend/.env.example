# Connect these values to enable real Supabase email/password authentication.
# Without them, the admin portal runs in the clearly labelled local preview mode.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-public-anon-key
REACT_APP_SUPABASE_BROCHURE_BUCKET=property-brochures
REACT_APP_SUPABASE_PHOTO_BUCKET=photo-studio
